{
  "expo": {
    "name": "Wortly",
    "slug": "wortly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "wortly",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wortly.app",
      "buildNumber": "13",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Wortly’nin dosya sistemi, uygulamaya bir fotoğraf kitaplığı dosya adresi verildiğinde bu öğeyi okuyabilir. Ses kayıtların ve öğrenme verilerin uygulamanın kendi alanında saklanır.",
        "NSSpeechRecognitionUsageDescription": "Wortly, senaryolarda Almanca cevabını sesle söylediğinde konuşmanı yazıya çevirmek için konuşma tanımayı kullanır. Tanıma yalnızca cihazında yapılır; ses ve metin cihazından çıkmaz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.wortly.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1F2B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "daily-review"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Wortly mikrofonu Almanca telaffuzunu kaydetmek ve senaryolarda Almanca cevap vermek için kullanır. Sesli cevap tanıması cihazında yapılır."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fbe2e36-3404-4e71-afea-db8deffca8d1"
      }
    },
    "owner": "bugrarslann"
  }
}
