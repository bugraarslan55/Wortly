{
  "expo": {
    "name": "Wortly",
    "slug": "wortly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "wortly",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wortly.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.wortly.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-status-bar",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1F2B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "daily-review"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Wortly, Almanca telaffuzunu kaydedip tekrar dinleyebilmen için mikrofonuna erişmek istiyor."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fbe2e36-3404-4e71-afea-db8deffca8d1"
      }
    },
    "owner": "bugrarslann"
  }
}
