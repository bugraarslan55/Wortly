# Kopyala: .env (git'e girmez). Gerçek değerleri Supabase Dashboard > Project Settings > API'den al.
# Sadece publishable (anon) key kullan; service_role/secret key ASLA buraya konmaz.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Cihazlar arası öğrenme senkronizasyonu (VARSAYILAN KAPALI; bu satır yoksa veya false ise kapalıdır).
# Yalnızca user_word_progress ve scenario_results tabloları o Supabase projesinde oluşturulduktan
# sonra, TEST projesinde .env.local içinde true yap. Üretimde tablolar yokken AÇMA.
EXPO_PUBLIC_LEARNING_SYNC=false

# --- Bağlantı güvenliği (docs/dev-environment.md) ---
# Production proje kimlik(ler)i (https://<kimlik>.supabase.co içindeki <kimlik>; virgülle ayrılır). Sır DEĞİLDİR.
# Geliştirme ve preview sürümleri bu kimliklerden birine bağlanırsa uygulama bağlantıyı KURMAZ. Yayın sürümü etkilenmez.
EXPO_PUBLIC_PRODUCTION_PROJECT_REFS=
# Ortam işareti: production | staging | local. Test projesi için .env.local içinde staging yaz.
# İşaret tek başına kanıt değildir; yukarıdaki kimlik karşılaştırmasıyla birlikte değerlendirilir.
EXPO_PUBLIC_APP_ENV=production
# Derleme profili eas.json (development/preview profilleri) tarafından otomatik verilir; elle ayarlama.
# EXPO_PUBLIC_BUILD_PROFILE=
